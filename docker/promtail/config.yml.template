server:
  #any free port: the container shares the host network, where a fixed port collides with another node or service
  http_listen_port: 0
  grpc_listen_port: 0

positions:
  filename: /reflector-node/app/home/promtail/positions.yaml

clients:
  - url: __ORCHESTRATOR_URL__/loki-proxy/loki/api/v1/push
    bearer_token_file: /reflector-node/app/home/promtail/token

scrape_configs:
  - job_name: reflector-node
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: reflector-node
          job: __PUBLIC_KEY__ 
          __path__: /reflector-node/app/home/logs/combined.log
    
    pipeline_stages:
      - json:
          expressions:
            level: level
            ctxId: ctxId
            contract: contract
            time: time
            msgType: msgType
            msgSender: msgSender

      - labels:
          level: level
          contract: contract
          runner: runner
      
      - timestamp:
          source: time
          format: RFC3339

  - job_name: reflector-node-metrics
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: reflector-node-metrics
          job: '__PUBLIC_KEY__'
          __path__: /reflector-node/app/home/logs/metrics/metrics.log

    pipeline_stages:
      - json:
          expressions:
            from: from
            to: to

      - timestamp:
          source: to
          format: RFC3339